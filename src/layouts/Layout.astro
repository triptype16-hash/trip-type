---
/**
 * src/layouts/Layout.astro
 */
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=Noto+Sans+JP:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>旅行タイプ診断｜あなたの旅の価値観がわかる無料診断</title>

    <!-- ✅ 各ページ固有の head を差し込む -->
    <slot name="head" />
  </head>

  <body>
    <!-- ✅ 上に固定される帯（sticky header） -->
    <header class="topbar" role="banner">
      <div class="topbarInner">
        <a class="brand" href="/" aria-label="トップへ">
          <!-- 左：小さい画像 -->
          <img class="brandMark" src="/brand/logo-mark.png" alt="Travel Type Test" />

          <!-- 右：もう1枚（横長ロゴなど） -->
          <img class="brandType" src="/brand/logo-type.png" alt="旅行タイプ診断" />
        </a>

        <div class="topbarRight">
          <!-- 右側に置きたい要素があればここ -->
        </div>
      </div>
    </header>

    <div class="page">
      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        <div class="footerInner">
          <nav class="footerNav" aria-label="フッターナビゲーション">
            <a href="/about">このサイトについて</a>
            <a href="/privacy">プライバシーポリシー</a>
            <a href="/terms">利用規約</a>
            <a href="/contact">お問い合わせ</a>
          </nav>

          <p class="footerCopy">© {new Date().getFullYear()} Travel Type Test</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* =========================
   * Base / Reset
   * ========================= */
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    font-family: "Inter", "Noto Sans JP", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;

    /* ✅ 読みやすいサイズ（必要ならここを上げ下げ） */
    font-size: clamp(17px, 1.15vw + 12px, 19px);

    line-height: 1.7;
    letter-spacing: 0.02em;
    color: rgba(16, 24, 40, 0.92);
    background: #fff;
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  /* =========================
   * Topbar（上に固定）
   * ========================= */
  .topbar {
  position: fixed;   /* ← ここが重要 */
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;

  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(16, 24, 40, 0.08);
}


  .topbarInner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    text-decoration: none;
    min-width: 0;

    /* ✅ 視覚的な重心のズレを少しだけ補正（上寄り対策） */
    transform: translateY(1px);
  }

  /* ✅ 画像のベースライン問題を消す */
  .brand img {
    display: block;
  }

  /* ✅ 左ロゴ：高さで揃える（横長でも自然に大きく） */
  .brandMark {
    height: 120px;
    width: auto;
    object-fit: contain;
    flex: 0 0 auto;
  }

  /* ✅ 右ロゴ：こちらも高さで揃える（200pxはNG） */
  .brandType {
    height: 220px;     /* 好みで 28〜36 */
    width: auto;
    object-fit: contain;
    max-width: 420px;
  }
  .topbarRight {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* =========================
   * Layout
   * ========================= */
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .content {
    flex: 1;
    padding: 96px 16px 56px;
  }

  /* =========================
   * Footer
   * ========================= */
  .footer {
    border-top: 1px solid rgba(16, 24, 40, 0.12);
    background: rgba(255, 255, 255, 0.95);
  }

  .footerInner {
    max-width: 980px;
    margin: 0 auto;
    padding: 16px 16px;
  }

  .footerNav {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.9rem;
    opacity: 0.92;
  }

  .footerNav a {
    text-decoration: none;
  }

  .footerNav a:hover {
    text-decoration: underline;
  }

  .footerCopy {
    margin: 10px 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(16, 24, 40, 0.65);
  }
</style>
