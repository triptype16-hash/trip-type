---
export const prerender = true;
const title = "お問い合わせ";
const formUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSfbHrTDuzmiIUYoeqqbw02mxxV5HT6bPIViYzxKpXQ6pheC6g/viewform?embedded=true";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="当サイトへのお問い合わせはこちらから。" />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <main style="max-width: 900px; margin: 0 auto; padding: 24px;">
      <h1>{title}</h1>

      <p>
        当サイトに関するご意見・ご質問は、以下のフォームよりご連絡ください。
      </p>

      <div style="margin-top: 16px;">
        <iframe
          src={formUrl}
          width="100%"
          height="900"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          style="border: 0; max-width: 720px;"
        >
          読み込んでいます…
        </iframe>
      </div>

      <p style="margin-top: 16px;">
        フォームが表示されない場合は、
        <a
          href={formUrl.replace("?embedded=true", "")}
          target="_blank"
          rel="noopener noreferrer"
        >
          こちら
        </a>
        から直接開いてください。
      </p>
    </main>
  </body>
</html>
