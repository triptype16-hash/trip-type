---
import Layout from "../layouts/Layout.astro";
import { questions } from "../data/questions";
---

<Layout>
  <Fragment slot="head">
    <title>旅行タイプ診断</title>
    <meta name="description" content="旅行に関する20問の回答から、あなたの旅行タイプを診断する無料テストです" />
    <style>
      .wrap {
        max-width: 920px; /* ✅ サイド広告を置くため少し広げる */
        margin: 0 auto;
        padding: 0 16px;
      }

      /* ===== ヘッダー背景（指定色） ===== */
      .hero {
        background: #08254e;
        color: #fff;
        border-radius: 18px;
        padding: 18px 16px;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0 0 6px;
        font-size: 28px;
        letter-spacing: 0.01em;
      }

      .lead {
        margin: 0;
        color: rgba(255, 255, 255, 0.86);
        line-height: 1.8;
      }

      .card {
        background: #fff;
        border: 1px solid rgba(16, 24, 40, 0.12);
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 10px 24px rgba(16, 24, 40, 0.06);
      }

      .q {
        padding: 14px 0;
        border-top: 1px solid rgba(16, 24, 40, 0.08);
      }
      .q:first-of-type {
        border-top: none;
      }

      .qHead {
        display: flex;
        gap: 10px;
        align-items: baseline;
        margin-bottom: 10px;
      }

      .qNum {
        font-weight: 900;
        font-size: 18px;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(16, 24, 40, 0.06);
      }

      .qText {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        line-height: 1.8;
      }

      /* ===== ✅ スケール：2行構成 =====
         1行目：丸（中央）
         2行目：左端「そう思う」 / 右端「そう思わない」
      */
      .scale{
        margin-top: 10px;
        width: 100%;
      }

      /* 丸7個は常に中央 */
      .scaleInner{
  display: grid;
  place-items: center;  /* ✅ 常に中央 */
  width: 100%;
}


      .scaleLabels{
        margin-top: 6px;
        display: flex;
        justify-content: space-between; /* ✅ 左右端 */
        align-items: center;
        width: 100%; /* ✅ カード全幅 */
      }

      .scaleLabel {
        font-weight: 900;
        font-size: 14px;
        white-space: nowrap;
        line-height: 1.1;
      }
      .scaleLabel.left {
        color: #1DC4B8;
        text-align: left;
      }
      .scaleLabel.right {
        color: #E38B3D;
        text-align: right;
      }

      /* ===========================
         7段階ラジオ：色＋押し心地（スカッと版）
         =========================== */

      .dots{
  --dot: clamp(22px, 5.4vw, 28px);
  --gap: clamp(8px, 2.4vw, 14px);

  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--gap);
  flex-wrap: nowrap;

  width: max-content;   /* ✅ 7個ぶんの幅＝中身ぴったり */
  max-width: 100%;
}


      .dotWrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;

        /* ✅ 棒化防止 */
        flex: 0 0 auto;

        /* ✅ タップしやすさ確保 */
        width: max(34px, var(--dot));
        height: max(34px, var(--dot));
      }

      /* ラジオ本体は不可視 */
      .dotInput {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      /* 丸：見た目本体（押し心地/アニメ維持） */
      .dot {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: var(--dot);
        height: var(--dot);
        min-width: var(--dot);
        min-height: var(--dot);
        flex: 0 0 var(--dot);
        box-sizing: border-box;

        border-radius: 999px;

        /* 初期（無色） */
        border: 2px solid rgba(16, 24, 40, 0.35);
        background: #fff;

        /* 外に色を出さない */
        box-shadow: inset 0 0 0 0 rgba(0,0,0,0);
        outline: none;

        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;

        transition:
          transform 90ms ease,
          border-color 140ms ease,
          background-color 140ms ease,
          box-shadow 140ms ease,
          filter 140ms ease;
      }

      @media (hover: hover) {
        .dotWrap:hover .dot {
          transform: translateY(-1px);
          filter: brightness(0.98);
        }
      }

      .dotWrap:active .dot {
        transform: translateY(0px) scale(0.92);
      }

      .dots > .dotWrap:nth-child(-n + 3) .dot {
        --border: #1dc4b8;
        --bg: rgba(29, 196, 184, 0.18);
        --core: rgba(29, 196, 184, 0.55);
      }

      .dots > .dotWrap:nth-child(4) .dot {
        --border: #9ca3af;
        --bg: rgba(156, 163, 175, 0.18);
        --core: rgba(156, 163, 175, 0.55);
      }

      .dots > .dotWrap:nth-child(n + 5) .dot {
        --border: #e38b3d;
        --bg: rgba(227, 139, 61, 0.18);
        --core: rgba(227, 139, 61, 0.55);
      }

      .dotInput:checked + .dot {
        border-color: var(--border);
        background-color: var(--bg);
        box-shadow: inset 0 0 0 3px var(--core);
        animation: snap 150ms cubic-bezier(.2,.9,.2,1);
      }

      .dotInput:focus-visible + .dot {
        border-color: var(--border);
        background-color: var(--bg);
        box-shadow: inset 0 0 0 3px var(--core);
      }

      @keyframes snap {
        0%   { transform: scale(0.92); }
        60%  { transform: scale(1.08); }
        100% { transform: scale(1.00); }
      }

      @media (prefers-reduced-motion: reduce) {
        .dot, .dotInput:checked + .dot { transition: none; animation: none; }
      }

      /* ===== ボタン ===== */
      .actions {
        position: relative;
        margin-top: 30px;
        min-height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .btn {
        appearance: none;
        border: none;
        background: #08254e;
        color: #ffffff;
        padding: 12px 18px;
        border-radius: 14px;
        font-size: 20px;
        font-weight: 700;
        cursor: pointer;
      }

      .btnSub {
        position: absolute;
        right: 0;
        top: 0;
        appearance: none;
        border: 1px solid rgba(16, 24, 40, 0.18);
        background: #fff;
        color: #101828;
        padding: 12px 16px;
        border-radius: 14px;
        font-weight: 900;
        cursor: pointer;
      }

      .notice {
        margin-top: 10px;
        color: rgba(16,24,40,0.70);
        font-size: 13px;
        line-height: 1.7;
      }

      .adWide {
        margin: 16px 0;
        border: 1px dashed rgba(16, 24, 40, 0.28);
        border-radius: 16px;
        padding: 14px;
        background: rgba(255, 255, 255, 0.9);
        text-align: center;
        font-weight: 900;
        color: rgba(16,24,40,0.6);
      }
      .adWide small{
        display:block;
        margin-top:6px;
        font-weight:800;
        opacity:.85;
      }

      /* ===== layout (PC: main + side ad) ===== */
      .pageLayout {
        display: grid;
        gap: 16px;
      }

      @media (min-width: 980px) {
        .pageLayout {
          grid-template-columns: minmax(0, 1fr) 300px;
          align-items: start;
        }
      }

      .adSide { display: none; }

      @media (min-width: 980px) {
        .adSide {
          display: block;
          position: sticky;
          top: 14px;

          width: 300px;
          height: 600px;
          box-sizing: border-box;

          border: 1px dashed rgba(16, 24, 40, 0.28);
          border-radius: 16px;
          padding: 14px;
          background: rgba(255, 255, 255, 0.9);
          text-align: center;
          font-weight: 900;
          color: rgba(16, 24, 40, 0.6);
        }
        .adSide small {
          display: block;
          margin-top: 6px;
          font-weight: 800;
          opacity: 0.85;
        }
      }

      /* ===== ✅ スマホ調整 ===== */
      @media (max-width: 420px) {
        /* Q表示を少し小さく */
        .qNum {
          font-size: 15px;
          padding: 3px 8px;
        }
        .qText {
          font-size: 16px;
          line-height: 1.75;
        }

        .scaleLabel { font-size: 13px; }

        /* ボタン被りを解消：縦積み＋小さく */
        .actions {
          position: static;
          min-height: auto;
          flex-direction: column;
          gap: 10px;
          align-items: stretch;
        }

        .btn, .btnSub {
          position: static;
          width: 100%;
          font-size: 16px;
          padding: 11px 14px;
          border-radius: 14px;
        }
      }

      @media (max-width: 360px) {
        .btn, .btnSub {
          font-size: 15px;
          padding: 10px 12px;
        }
      }
    </style>
  </Fragment>

  <div class="wrap">
    <div class="hero">
      <h1>旅行タイプ診断</h1>
      <p class="lead">旅行に関する20問の回答から、あなたの旅行タイプを診断する無料テストです</p>
    </div>

    <div class="pageLayout">
      <!-- Main -->
      <div>
        <form class="card" id="diagForm">
          {questions.map((q, i) => (
            <>
              <div
                class="q"
                data-axis={q.axis}
                data-side={q.side}
                data-qid={q.id}
              >
                <div class="qHead">
                  <span class="qNum">Q{i + 1}</span>
                  <p class="qText">{q.text}</p>
                </div>

                {/* ✅ 2行構成：丸は中央、ラベルは左右端（1回だけ） */}
                <div class="scale">
                  <div class="scaleInner">
                    <div class="dots" role="radiogroup" aria-label={`Q${i + 1}`}>
                      {[
                        { v: 3, side: "green" },
                        { v: 2, side: "green" },
                        { v: 1, side: "green" },
                        { v: 0, side: "gray" },
                        { v: -1, side: "orange" },
                        { v: -2, side: "orange" },
                        { v: -3, side: "orange" },
                      ].map((opt, j) => (
                        <div class="dotWrap">
                          <input
                            class="dotInput"
                            type="radio"
                            id={`q${q.id}_${j}`}
                            name={`q${q.id}`}
                            value={String(opt.v)}
                            required
                          />
                          <label class="dot" for={`q${q.id}_${j}`} aria-label="選択" />
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="scaleLabels" aria-hidden="true">
                    <div class="scaleLabel left">そう思う</div>
                    <div class="scaleLabel right">そう思わない</div>
                  </div>
                </div>
              </div>

              {/* ✅ Q10（= i===9）の直後に広告枠 */}
              {i === 9 && (
                <div class="adWide" aria-label="広告枠">
                  広告枠
                  <small>レスポンシブ広告</small>
                </div>
              )}
            </>
          ))}

          <div class="actions">
            <button class="btn" type="submit">結果を見る</button>
            <button class="btnSub" type="reset">リセット</button>
          </div>

          <p class="notice">
            ※ 本診断は娯楽・自己理解を目的としたものであり、結果の正確性や特定の行動を保証するものではありません。
          </p>

          <div class="adWide" aria-label="広告枠">
            広告枠
            <small>レスポンシブ広告</small>
          </div>
        </form>
      </div>

      <!-- Side Ad (PC only) -->
      <aside class="adSide" aria-label="広告枠（サイド 300×600）">
        広告枠（300×600）
        <small>PCのみ表示</small>
      </aside>
    </div>
  </div>

  <script define:vars={{ questions }}>
    const form = document.getElementById("diagForm");

    // 5軸スコア（Companyも保持）
    const scores = {
      Tactics: { Planned: 0, Flexible: 0 },
      Discovery: { Classic: 0, Exploring: 0 },
      Comfort: { Luxurious: 0, Budget: 0 },
      Pace: { Active: 0, Relaxed: 0 },
      Company: { Group: 0, Solo: 0 },
    };

    function otherSide(axis, side) {
      return Object.keys(scores[axis]).find((s) => s !== side);
    }

    function axisPercent(axis, sideA) {
      const keys = Object.keys(scores[axis]);
      const sideB = keys.find((k) => k !== sideA);
      const a = scores[axis][sideA];
      const b = scores[axis][sideB];
      const total = a + b;
      if (!total) return 50;
      return Math.round((a / total) * 100);
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      // 初期化
      for (const ax of Object.keys(scores)) {
        for (const s of Object.keys(scores[ax])) scores[ax][s] = 0;
      }

      // 全回答を集計
      const blocks = document.querySelectorAll(".q");
      for (const b of blocks) {
        const axis = b.dataset.axis;
        const side = b.dataset.side;

        const qid = b.dataset.qid;
        const checked = b.querySelector(`input[name="q${qid}"]:checked`);
        if (!checked) {
          alert("未回答の質問があります。すべて回答してください。");
          return;
        }

        const value = Number(checked.value);

        if (value > 0) {
          scores[axis][side] += value;
        } else if (value < 0) {
          const os = otherSide(axis, side);
          scores[axis][os] += Math.abs(value);
        }
      }

      // 保存
      localStorage.setItem("travelScores", JSON.stringify(scores));

      // 4軸のみでタイプ決定
      const result =
        (scores.Tactics.Planned >= scores.Tactics.Flexible ? "P" : "F") +
        (scores.Discovery.Classic >= scores.Discovery.Exploring ? "C" : "E") +
        (scores.Comfort.Luxurious >= scores.Comfort.Budget ? "L" : "B") +
        (scores.Pace.Active >= scores.Pace.Relaxed ? "A" : "R");

      // 5軸の%（左側%）
      const t = axisPercent("Tactics", "Planned");
      const d = axisPercent("Discovery", "Classic");
      const c = axisPercent("Comfort", "Luxurious");
      const p = axisPercent("Pace", "Active");
      const co = axisPercent("Company", "Group");

      const qs = new URLSearchParams({
        t: String(t),
        d: String(d),
        c: String(c),
        p: String(p),
        co: String(co),
      });

      localStorage.setItem("tripType:lastResult", result);
      location.href = `/result/${result}?${qs.toString()}`;
    });
  </script>
</Layout>
